    \"m_DrawState\": {\n        \"m_Expanded\": true,\n        \"m_Position\": {\n           
    \"serializedVersion\": \"2\",\n            \"x\": -3025.60009765625,\n           
    \"y\": -186.3999786376953,\n            \"width\": 267.199951171875,\n           
    \"height\": 118.4000015258789\n        }\n    },\n    \"m_Slots\": [\n       

    ],\n    \"synonyms\": [],\n    \"m_Precision\": 0,\n    \"m_PreviewExpanded\":
    false,\n    \"m_PreviewMode\": 0,\n    \"m_CustomColors\": {\n        \"m_SerializableColors\":
    []\n    },\n    \"m_SourceType\": 1,\n    \"m_FunctionName\": \"Decode_Quaternion\",\n   
    \"m_FunctionSource\": \"\",\n    \"m_FunctionBody\": \"float w = sqrt(1.0 - pow(XYZ.x,
    2) - pow(XYZ.y, 2) - pow(XYZ.z, 2));\\r\\nfloat4 q = float4(0, 0, 0, 1);\\r\\n\\r\\nswitch(MaxComponent)\\r\\n{\\r\\n   
    case 0:\\r\\n        q = float4(XYZ.x, XYZ.y, XYZ.z, w);\\r\\n        break;\\r\\n   
    case 1:\\r\\n        q = float4(w, XYZ.y, XYZ.z, XYZ.x);\\r\\n        break;\\r\\n   
    case 2:\\r\\n        q = float4(XYZ.x, -w, XYZ.z, -XYZ.y);\\r\\n        break;\\r\\n   
    case 3:\\r\\n        q = float4(XYZ.x, XYZ.y, -w, -XYZ.z);\\r\\n        break;\\r\\n   
    default:\\r\\n        q = float4(XYZ.x, XYZ.y, XYZ.z, w);\\r\\n        break;\\r\\n}\\r\\n\\r\\nOut_XYZW
    = q;\"\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.DynamicValueMaterialSlot\",\n   
